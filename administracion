<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Panel de Administración · Tutores Académicos 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Staatliches&display=swap" rel="stylesheet">
<style>
:root{--carbon:#101112;--carbon2:#17191b;--panel:#1c1e20;--line:#33373b;--cream:#f4efe5;--muted:#aeb3b7;--red:#c8272d;--red2:#8b0000;--gold:#d4a94e;--ok:#50b779;--warn:#e2ad4c}
*{box-sizing:border-box}body{margin:0;background:var(--carbon);color:var(--cream);font-family:Barlow,Arial,sans-serif}
button,input,select{font:inherit}.shell{max-width:1500px;margin:auto;padding:24px}.hero{border-bottom:1px solid var(--line);padding:18px 0 24px;margin-bottom:22px;display:flex;gap:20px;justify-content:space-between;align-items:end}
.eyebrow{color:var(--gold);font-size:.78rem;text-transform:uppercase;letter-spacing:.16em;font-weight:800}.hero h1{font-family:Staatliches,sans-serif;font-size:clamp(2rem,4vw,3.5rem);letter-spacing:.04em;margin:4px 0 0;font-weight:400}.hero p{margin:5px 0 0;color:var(--muted)}
.logout{border:1px solid var(--line);background:transparent;color:var(--cream);padding:10px 14px;cursor:pointer}.logout:hover{border-color:var(--red)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}.stat{background:var(--panel);border:1px solid var(--line);border-top:3px solid var(--red);padding:16px}.stat b{font-family:Staatliches;font-size:2rem;font-weight:400;display:block}.stat span{font-size:.78rem;text-transform:uppercase;color:var(--muted);letter-spacing:.06em}
.toolbar{background:var(--panel);border:1px solid var(--line);padding:12px;display:grid;grid-template-columns:1fr 240px auto;gap:10px;margin-bottom:12px}
input,select{width:100%;background:#111315;border:1px solid var(--line);color:var(--cream);padding:11px 12px;outline:none}input:focus,select:focus{border-color:var(--gold)}
.btn{border:0;background:var(--red);color:#fff;font-weight:800;padding:11px 16px;cursor:pointer}.btn:hover{filter:brightness(1.08)}
.table-wrap{border:1px solid var(--line);overflow:auto;background:var(--panel)}table{width:100%;border-collapse:collapse;min-width:1200px}th{position:sticky;top:0;background:#24272a;color:var(--gold);font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;text-align:left;padding:12px;border-bottom:1px solid var(--line)}td{padding:12px;border-bottom:1px solid #2c2f32;vertical-align:top;font-size:.9rem}tr:hover td{background:#202326}
.pill{display:inline-block;padding:4px 7px;margin:2px 3px 2px 0;border:1px solid #4b4f53;font-size:.72rem}.link{color:var(--gold);text-decoration:none;font-weight:700}.link:hover{text-decoration:underline}.empty{text-align:center;color:var(--muted);padding:42px!important}
.status{margin:10px 0;color:var(--muted);font-size:.85rem}.error{color:#ff8e92}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.82);display:flex;align-items:center;justify-content:center;padding:20px;z-index:20}.login{width:min(430px,100%);background:var(--panel);border:1px solid var(--line);border-top:4px solid var(--red);padding:28px}.login h2{font-family:Staatliches;font-size:2rem;margin:0 0 4px;font-weight:400}.login p{color:var(--muted);margin:0 0 20px}.login .btn{width:100%;margin-top:10px}.hidden{display:none!important}
.modal{width:min(760px,100%);max-height:85vh;overflow:auto;background:var(--panel);border:1px solid var(--line);padding:24px}.modal-head{display:flex;justify-content:space-between;gap:15px;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:15px}.modal h2{font-family:Staatliches;font-size:1.8rem;margin:0;font-weight:400}.close{background:none;border:0;color:#fff;font-size:1.5rem;cursor:pointer}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.detail{border:1px solid var(--line);padding:12px}.detail.full{grid-column:1/-1}.detail small{display:block;color:var(--gold);text-transform:uppercase;font-weight:800;margin-bottom:5px}.detail div{white-space:pre-wrap}
@media(max-width:850px){.stats{grid-template-columns:1fr 1fr}.toolbar{grid-template-columns:1fr}.hero{align-items:start;flex-direction:column}.detail-grid{grid-template-columns:1fr}.detail.full{grid-column:auto}}
</style>
</head>
<body>
<main class="shell">
  <header class="hero">
    <div>
      <div class="eyebrow">Dirección Nacional de Bomberos · 2026</div>
      <h1>Administración · Tutores Académicos</h1>
      <p>Consulta centralizada de postulaciones, currículums y resúmenes PDF.</p>
    </div>
    
  </header>

  <section class="stats">
    <div class="stat"><b id="stTotal">0</b><span>Postulaciones</span></div>
    <div class="stat"><b id="stCadetes">0</b><span>Licenciatura Cadetes</span></div>
    <div class="stat"><b id="stPasaje">0</b><span>Pasaje de Grado</span></div>
    <div class="stat"><b id="stEspecialidades">0</b><span>Esc. Especialidades</span></div>
  </section>

  <section class="toolbar">
    <input id="search" type="search" placeholder="Buscar por nombre, apellido, correo, materia o ID...">
    <select id="filter">
      <option value="">Todas las postulaciones</option>
      <option>Licenciatura de Cadetes</option>
      <option>Pasaje de Grado</option>
      <option>Escuela de Especialidades</option>
      <option>Instructor de Cursos</option>
    </select>
    <div style="display:flex;gap:8px"><button class="btn" id="refreshBtn">ACTUALIZAR</button><button class="btn" id="pdfBtn" style="background:#d4a94e;color:#101112">GENERAR PDF GENERAL</button></div>
  </section>

  <div id="status" class="status">Cargando postulaciones...</div>
  <section class="table-wrap">
    <table>
      <thead><tr>
        <th>Fecha</th><th>Postulante</th><th>Correo</th><th>Postulación académica</th>
        <th>Materia / Área</th><th>CV</th><th>Resumen PDF</th><th>Detalle</th>
      </tr></thead>
      <tbody id="tbody"><tr><td colspan="8" class="empty">Sin datos cargados.</td></tr></tbody>
    </table>
  </section>
</main>

<div id="detailOverlay" class="overlay hidden">
  <div class="modal">
    <div class="modal-head"><div><div class="eyebrow">Ficha de postulación</div><h2 id="detailTitle"></h2></div><button class="close" id="closeModal">×</button></div>
    <div id="detailBody" class="detail-grid"></div>
  </div>
</div>

<script>
const API_URL="https://script.google.com/macros/s/AKfycbzcZ9tPPySkESW5IMiAL2g8hkVnQ4xaRfq3A0F3PVxYr415-Xm-EQ5Hh2NZ8usTGw0O/exec";

let DATA=[];

const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
const arr=v=>Array.isArray(v)?v:String(v||"").split("|").map(x=>x.trim()).filter(Boolean);

async function loadData(){
  $("status").textContent="Cargando postulaciones...";
  $("status").className="status";
  try{
    const url=API_URL+"?action=adminList&_="+Date.now();
    const r=await fetch(url,{method:"GET",redirect:"follow"});
    const text=await r.text();
    let j;
    try{j=JSON.parse(text)}catch{throw new Error("La API no devolvió JSON. Verifique la implementación del Apps Script.");}
    if(!j.ok) throw new Error(j.mensaje||"Acceso no autorizado.");
    DATA=Array.isArray(j.data)?j.data:[];
    render();
    $("status").textContent="Última actualización: "+new Date().toLocaleString("es-UY");
  }catch(e){
    $("status").textContent=e.message;
    $("status").className="status error";
    throw e;
  }
}

function render(){
  const q=$("search").value.trim().toLowerCase();
  const f=$("filter").value;
  const filtered=DATA.filter(x=>{
    const blob=[x.id,x.nombre,x.apellido,x.correo,x.materia,x.idoneidad,arr(x.postulacion).join(" ")].join(" ").toLowerCase();
    return (!q||blob.includes(q)) && (!f||arr(x.postulacion).includes(f));
  });

  $("stTotal").textContent=DATA.length;
  $("stCadetes").textContent=DATA.filter(x=>arr(x.postulacion).includes("Licenciatura de Cadetes")).length;
  $("stPasaje").textContent=DATA.filter(x=>arr(x.postulacion).includes("Pasaje de Grado")).length;
  $("stEspecialidades").textContent=DATA.filter(x=>arr(x.postulacion).includes("Escuela de Especialidades")).length;

  $("tbody").innerHTML=filtered.length?filtered.map((x,i)=>`
    <tr>
      <td>${esc(x.fecha||"")}</td>
      <td><strong>${esc(x.apellido||"")}, ${esc(x.nombre||"")}</strong><br><small>${esc(x.id||"")}</small></td>
      <td>${esc(x.correo||"")}</td>
      <td>${arr(x.postulacion).map(p=>`<span class="pill">${esc(p)}</span>`).join("")}</td>
      <td>${esc(x.materia||"")}</td>
      <td>${x.enlaceCV?`<a class="link" href="${esc(x.enlaceCV)}" target="_blank" rel="noopener">Abrir CV</a>`:"—"}</td>
      <td>${x.enlacePDF?`<a class="link" href="${esc(x.enlacePDF)}" target="_blank" rel="noopener">Abrir PDF</a>`:"—"}</td>
      <td><button class="btn" onclick="showDetail(${DATA.indexOf(x)})">VER</button></td>
    </tr>`).join(""):`<tr><td colspan="8" class="empty">No hay postulaciones que coincidan con la búsqueda.</td></tr>`;
}

function showDetail(i){
  const x=DATA[i]; if(!x)return;
  $("detailTitle").textContent=(x.apellido||"")+" "+(x.nombre||"");
  const fields=[
    ["ID de postulación",x.id],["Fecha y hora",x.fecha],["Nombre",x.nombre],["Apellido",x.apellido],
    ["Correo",x.correo],["Postulación académica",arr(x.postulacion).join("\n")],
    ["Materia / Área",x.materia],["Idoneidad",x.idoneidad]
  ];
  $("detailBody").innerHTML=fields.map(([k,v],n)=>`<div class="detail ${n>=5?"full":""}"><small>${esc(k)}</small><div>${esc(v||"—")}</div></div>`).join("")+
    `<div class="detail full"><small>Archivos</small><div>${x.enlaceCV?`<a class="link" href="${esc(x.enlaceCV)}" target="_blank">Abrir Currículum</a>`:"Sin CV"} &nbsp; · &nbsp; ${x.enlacePDF?`<a class="link" href="${esc(x.enlacePDF)}" target="_blank">Abrir resumen PDF</a>`:"Sin PDF"}</div></div>`;
  $("detailOverlay").classList.remove("hidden");
}

$("refreshBtn").onclick=()=>loadData().catch(()=>{});
$("pdfBtn").onclick=async()=>{
  const btn=$("pdfBtn");
  const old=btn.textContent;
  btn.disabled=true;
  btn.textContent="GENERANDO...";
  $("status").textContent="Generando PDF general de postulaciones...";
  try{
    const url=API_URL+"?action=adminPDF&_="+Date.now();
    const r=await fetch(url,{method:"GET",redirect:"follow"});
    const text=await r.text();
    let j;
    try{j=JSON.parse(text)}catch{throw new Error("La API no devolvió JSON al generar el PDF.");}
    if(!j.ok) throw new Error(j.mensaje||"No se pudo generar el PDF.");
    $("status").textContent="PDF general generado correctamente.";
    if(j.url) window.open(j.url,"_blank","noopener");
  }catch(e){
    $("status").textContent=e.message;
    $("status").className="status error";
  }finally{
    btn.disabled=false;
    btn.textContent=old;
  }
};
$("search").oninput=render;$("filter").onchange=render;
$("closeModal").onclick=()=>$("detailOverlay").classList.add("hidden");
$("detailOverlay").addEventListener("click",e=>{if(e.target===$("detailOverlay"))$("detailOverlay").classList.add("hidden")});

loadData().catch(()=>{})
</script>
</body>
</html>
